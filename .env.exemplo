# Copie para .env e ajuste. O .env não vai para o git.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=sabia
POSTGRES_USER=sabia
POSTGRES_PASSWORD=sabia

# Endereço do frontend (usado no link de "Esqueci minha senha")
FRONTEND_URL=http://localhost:5173

# E-mail. Sem configurar, os e-mails aparecem no terminal do backend (bom para desenvolvimento).
# Para enviar de verdade (ex.: Gmail com senha de app), descomente e preencha:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Sabiá <seu-email@gmail.com>
